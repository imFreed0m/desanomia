# Backend Environment Configuration Template
# Governed by brain/08_SECURITY.md, brain/11_API_CONTRACT.md, brain/15_DEPLOYMENT.md
APP_ENV=development
APP_NAME="Desanomia Edge API"
APP_VERSION=1.0.0
DEBUG=false
TZ=Asia/Jakarta

# Database (PostgreSQL 16)
DB_USER=desanomia_app
DB_PASS=desanomia_secure_pass_change_me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=desanomia
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# MQTT Broker (Mosquitto 2.0 on OT LAN)
MQTT_HOST=192.168.10.1
MQTT_PORT=1883
MQTT_CLIENT_USER=backend_service
MQTT_CLIENT_PASS=mqtt_backend_pass_change_me
MQTT_KEEPALIVE=60

# Authentication & JWT
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_ELEVATION_EXPIRE_MINUTES=15

# Telegram Notification Bot (Optional WAN sync)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
